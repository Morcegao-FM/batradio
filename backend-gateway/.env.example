# Porta HTTP do gateway
PORT=8080

# Backend Node legado (rede interna do docker compose)
NODE_BACKEND_URL=http://node-backend:9320
NODE_API_KEY=troque-pela-chave-do-config.json

# Credenciais OAuth (Google Cloud Console → APIs & Services → Credentials)
# Tipo: Web application. Authorized redirect URI = OAUTH_REDIRECT_URL abaixo.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
OAUTH_REDIRECT_URL=https://batradio.morcegaofm.com.br/auth/callback

# E-mails com acesso (separados por vírgula, exatos)
ALLOWED_EMAILS=aguergolet@gmail.com,morcegaofm@gmail.com

# Segredo de assinatura das sessões (>= 32 bytes; ex.: openssl rand -hex 32)
SESSION_SECRET=

# Stream do Icecast para o monitor local no player (opcional)
STREAM_URL=

# Login de desenvolvimento sem Google (NUNCA em produção)
DEV_MODE=false

# Cookie de sessão com Secure. true em produção; false só em http://localhost.
# Com Secure ligado o cookie ganha o prefixo __Host-.
COOKIE_SECURE=true

# Catálogo de faixas da API do website (capa, artista, ano). Opcional: sem isso
# o painel roda, só que sem capa. A chave é a mesma de Servico__Chave na API.
CATALOGO_URL=http://api:8080
CATALOGO_CHAVE=
